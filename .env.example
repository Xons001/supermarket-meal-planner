COMPOSE_PROJECT_NAME=supermarket-meal-planner

POSTGRES_DB=meal_planner
POSTGRES_USER=meal_planner
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST_PORT=5433

BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5173

# Required. Generate locally, for example: openssl rand -base64 48
MEAL_PLAN_PREVIEW_HMAC_SECRET=
MEAL_PLAN_PREVIEW_TTL=PT15M

# Required and distinct. Generate each locally: openssl rand -base64 48
APP_AUTH_ACCESS_TOKEN_SECRET=
APP_AUTH_REFRESH_TOKEN_SECRET=
APP_AUTH_ACCESS_TTL=PT15M
APP_AUTH_REFRESH_TTL=P30D
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_ALLOWED_ORIGINS=http://localhost:5173
APP_AUTH_SWAGGER_ENABLED=true

# Optional demo/admin accounts are disabled unless explicitly enabled.
APP_DEMO_ENABLED=false
APP_DEMO_EMAIL=
APP_DEMO_PASSWORD=
APP_ADMIN_ENABLED=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# FASE 9. Generate every secret independently (for example: openssl rand -base64 48).
APP_CATALOG_SYNC_ENABLED=true
APP_CATALOG_SYNC_PROVIDER=LOCAL_JSON
APP_CATALOG_FULL_SYNC_SCHEDULE=0 3 * * *
APP_CATALOG_PRICE_SYNC_SCHEDULE=0 */6 * * *
APP_CATALOG_SYNC_STAGING_RETENTION_DAYS=7
APP_CATALOG_SYNC_MANUAL_RATE_PER_HOUR=10
AIRFLOW_UI_HOST_PORT=8082
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_METADATA_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_API_JWT_SECRET=
AIRFLOW_WEBSERVER_SECRET_KEY=

# FASE 10. LOCAL_JSON is deterministic and does not access the Internet.
APP_NUTRITION_ENRICHMENT_ENABLED=true
APP_NUTRITION_ENRICHMENT_CRON=0 4 * * 1
APP_NUTRITION_PROVIDER=LOCAL_JSON
APP_NUTRITION_BATCH_SIZE=100
APP_NUTRITION_AUTO_ACCEPT_THRESHOLD=95
APP_NUTRITION_MANUAL_REVIEW_THRESHOLD=75
APP_NUTRITION_CACHE_TTL=P7D
APP_NUTRITION_CACHE_TTL_DAYS=7
APP_NUTRITION_REJECTION_COOLDOWN=P30D
APP_NUTRITION_REJECTION_COOLDOWN_DAYS=30
APP_NUTRITION_MANUAL_RATE_PER_HOUR=10
NUTRITION_PROVIDER_FILE=/opt/airflow/data/mock/mercadona-catalog.json
NUTRITION_OVERRIDE_FILE=/opt/airflow/data/providers/nutrition/local-nutrition-overrides.json

# Experimental external provider. Keep disabled unless a contact User-Agent is configured.
APP_OPENFOODFACTS_ENABLED=false
APP_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
APP_OPENFOODFACTS_USER_AGENT=SupermarketMealPlanner/0.1 (contact@example.invalid)

# FASE 11 / producción. No reutilices secretos entre variables.
# Genera cada uno externamente (por ejemplo: openssl rand -base64 48).
SPRING_PROFILES_ACTIVE=development
APP_OBSERVABILITY_USER_HASH_SECRET=
APP_AUTH_ISSUER=https://meal-planner.example.com
APP_VERSION=0.11.0-dev
APP_COMMIT=unknown
APP_BUILD_TIME=unknown
PUBLIC_BASE_URL=https://meal-planner.example.com
TLS_CERT_PATH=
TLS_KEY_PATH=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_HOST_PORT=3000
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
