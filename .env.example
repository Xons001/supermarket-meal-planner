COMPOSE_PROJECT_NAME=supermarket-meal-planner

POSTGRES_DB=meal_planner
POSTGRES_USER=meal_planner
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST_PORT=5433

BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=5173

# Required. Generate locally, for example: openssl rand -base64 48
MEAL_PLAN_PREVIEW_HMAC_SECRET=
MEAL_PLAN_PREVIEW_TTL=PT15M

# Required and distinct. Generate each locally: openssl rand -base64 48
APP_AUTH_ACCESS_TOKEN_SECRET=
APP_AUTH_REFRESH_TOKEN_SECRET=
APP_AUTH_ACCESS_TTL=PT15M
APP_AUTH_REFRESH_TTL=P30D
APP_AUTH_COOKIE_SECURE=false
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_ALLOWED_ORIGINS=http://localhost:5173
APP_AUTH_SWAGGER_ENABLED=true

# Optional demo/admin accounts are disabled unless explicitly enabled.
APP_DEMO_ENABLED=false
APP_DEMO_EMAIL=
APP_DEMO_PASSWORD=
APP_ADMIN_ENABLED=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
